<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_light"
    tools:context="armameeldopartimobile.activities.NamesInputActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <ImageView
        android:id="@+id/app_icon_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:contentDescription="@string/app_icon_description"
        android:src="@drawable/bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ImageContrastCheck" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/activity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/names_input_activity_title"
        android:textAlignment="center"
        android:textColor="@color/green_dark"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/app_icon_image"
        app:layout_constraintStart_toEndOf="@+id/app_icon_image"
        app:layout_constraintTop_toTopOf="@+id/app_icon_image" />

    <View
        android:id="@+id/divider"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:layout_marginTop="15dp"
        android:background="@color/green_medium"
        android:clickable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_title" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_view_cd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/names_input_activity_cd_label"
        android:textAlignment="center"
        android:textColor="@color/green_dark_medium"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_cd_1"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_cd"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck,DuplicateSpeakableTextCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_cd_2"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_cd_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_cd_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_view_ld"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/names_input_activity_ld_label"
        android:textAlignment="center"
        android:textColor="@color/green_dark_medium"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_cd_1" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_ld_1"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_ld"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_ld_2"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_ld_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_ld_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_ld_3"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_ld_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_ld_4"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_ld_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_ld_3"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_view_mf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/names_input_activity_mf_label"
        android:textAlignment="center"
        android:textColor="@color/green_dark_medium"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_ld_3" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_mf_1"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_mf"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_mf_2"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_mf_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_mf_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_mf_3"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_mf_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_mf_4"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_mf_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_mf_3"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_view_fw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/names_input_activity_fw_label"
        android:textAlignment="center"
        android:textColor="@color/green_dark_medium"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_mf_3" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_fw_1"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_fw"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_fw_2"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_fw_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_fw_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_view_gk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/names_input_activity_gk_label"
        android:textAlignment="center"
        android:textColor="@color/green_dark_medium"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_fw_1" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_gk_1"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_gk"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_gk_2"
        style="@style/CustomEditTextStyle"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text_gk_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="@+id/edit_text_gk_1"
        tools:ignore="VisualLintTextFieldSize,TextContrastCheck" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/start_button"
        style="@style/CustomButtonStyle"
        android:onClick="launchNextActivity"
        android:text="@string/names_input_activity_continue_button"
        app:layout_constraintBottom_toTopOf="@+id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="VisualLintButtonSize" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/back_button"
        style="@style/CustomButtonStyle"
        android:text="@string/names_input_activity_back_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="VisualLintButtonSize" />

</androidx.constraintlayout.widget.ConstraintLayout>