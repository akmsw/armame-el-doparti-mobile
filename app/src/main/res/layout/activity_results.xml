<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_light"
    tools:context="armameeldopartimobile.activities.NamesInputActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <ImageView
        android:id="@+id/app_icon_image"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:clickable="false"
        android:contentDescription="@string/app_icon_description"
        android:src="@drawable/bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ImageContrastCheck" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/activity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:clickable="false"
        android:fontFamily="@font/comfortaa"
        android:text="@string/activity_results_title"
        android:textAlignment="center"
        android:textColor="@color/green_dark"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@+id/app_icon_image"
        app:layout_constraintStart_toEndOf="@+id/app_icon_image"
        app:layout_constraintTop_toTopOf="@+id/app_icon_image" />

    <View
        android:id="@+id/divider"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:layout_marginTop="15dp"
        android:background="@color/green_medium"
        android:clickable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_title" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/container_teams"
        style="@style/CustomLabelStyle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/green_light_white"
        app:layout_constraintBottom_toTopOf="@+id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/container_team_1"
        style="@style/CustomLabelStyle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:backgroundTint="@color/green_light"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="@+id/container_teams"
        app:layout_constraintStart_toStartOf="@+id/container_teams"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintTop_toTopOf="@+id/container_teams" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/container_team_2"
        style="@style/CustomLabelStyle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/green_light"
        app:layout_constraintBottom_toBottomOf="@+id/container_teams"
        app:layout_constraintEnd_toEndOf="@+id/container_teams"
        app:layout_constraintStart_toStartOf="@+id/container_teams"
        app:layout_constraintTop_toBottomOf="@+id/guideline" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/back_button"
        style="@style/CustomButtonStyle"
        android:text="@string/activity_names_input_button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="VisualLintButtonSize" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_team_1"
        style="@style/CustomLabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/green_medium"
        android:fontFamily="@font/comfortaa"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/activity_results_label_team_1"
        android:textColor="@color/green_light_white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/container_team_1"
        app:layout_constraintTop_toTopOf="@+id/container_team_1" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_team_2"
        style="@style/CustomLabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/green_medium"
        android:fontFamily="@font/comfortaa"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/activity_results_label_team_2"
        android:textColor="@color/green_light_white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/container_team_2"
        app:layout_constraintTop_toTopOf="@+id/container_team_2" />

</androidx.constraintlayout.widget.ConstraintLayout>